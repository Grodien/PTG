rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'thomas.bomatter@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Stammdaten: öffentlich lesbar, nur Admin schreibt
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bestellungen: öffentlich anlegen, nur Admin lesen. Der Admin darf per
    // Client ausschliesslich den Erledigt-Status (`done`/`doneAt`) setzen –
    // die bestellungs-relevanten Kernfelder bleiben unveränderbar. Löschen
    // bleibt gesperrt; Status-Felder von der Cloud Function (Admin SDK) sind
    // davon unberührt.
    match /orders/{id} {
      allow create: if isValidOrder(request.resource.data);
      allow read:   if isAdmin();
      allow update: if isAdmin() && isOnlyDoneChange();
      allow delete: if false;
    }

    // Push-Token: nur Admin
    match /pushTokens/{id} {
      allow read, write: if isAdmin();
    }

    // Erlaubt dem Admin nur das Ändern von `done`/`doneAt`; alle anderen
    // Felder müssen gegenüber dem bestehenden Dokument unverändert bleiben.
    function isOnlyDoneChange() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['done', 'doneAt'])
        && (after.done is bool);
    }

    function isValidOrder(d) {
      return d.total is int && d.total >= 0
        && d.itemCount is int && d.itemCount >= 1
        && d.lines is list
        && (d.note == null || d.note is string);
    }
  }
}
